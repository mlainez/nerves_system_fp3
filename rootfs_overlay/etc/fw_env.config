# fw_printenv and fw_setenv configuration
#
# Used purely as a key/value store for Nerves firmware metadata. lk2nd
# is the actual bootloader; U-Boot is not involved on the FP3. The env
# area lives inside the Android userdata partition at offset 0x100000
# (UBOOT_ENV_OFFSET 2048 blocks * 512 = 1 MiB; UBOOT_ENV_COUNT 16
# blocks * 512 = 8 KiB) — see fwup_include/fwup-common.conf.

# Device name		Device offset	Env. size	Flash sector size	Number of sectors
/dev/mmcblk0p62		0x100000	0x2000		0x200			16
