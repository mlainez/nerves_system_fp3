# erlinit configuration for Fairphone 3
#
# Override from your app by following:
# https://hexdocs.pm/nerves/advanced-configuration.html#overriding-erlinit-config-from-mix-config

# Uncomment for debug prints
# -v

# IEx console destinations on the FP3. tty1 is the on-screen framebuffer (the
# Nerves prompt lands on the phone's display); ttyMSM0 is the serial debug
# port that requires soldering wires under the back cover.
-c tty1
# -c ttyMSM0

--warn-unused-tty

# Use nbtty for nicer terminal handling on serial consoles.
-s "/usr/bin/nbtty"

# The qrtr / rmtfs / tqftpserv / hexagonrpcd / modem bring-up that the
# citronics buildroot port did from /etc/init.d/S* lives in standalone
# OTP applications (ex_kernel_modules, ex_rmtfs, ex_tqftpserv,
# ex_hexagonrpcd, ex_hexagonfs, ex_modem_boot, vintage_net_qmi). They
# get listed in the user app's extra_applications and start themselves.
# There is intentionally no --pre-run-exec hook here.

# Enable UTF-8 filename handling in Erlang and custom inet configuration
-e LANG=en_US.UTF-8;LANGUAGE=en;ERL_INETRC=/etc/erl_inetrc

# Enable crash dumps (set ERL_CRASH_DUMP_SECONDS=0 to disable)
-e ERL_CRASH_DUMP=/root/erl_crash.dump;ERL_CRASH_DUMP_SECONDS=5

# Mount the kernel virtual filesystems Nerves expects.
-m debugfs:/sys/kernel/debug:debugfs:nodev,noexec,nosuid
-m pstore:/sys/fs/pstore:pstore:nodev,noexec,nosuid:
-m tmpfs:/sys/fs/cgroup:tmpfs:nodev,noexec,nosuid:mode=755,size=1024k
-m cpu:/sys/fs/cgroup/cpu:cgroup:nodev,noexec,nosuid:cpu
# configfs lets vintage_net_direct (or any userspace tool) configure
# the USB OTG gadget. The initramfs already brought up the gadget
# before switch_root; remounting configfs here gives the running
# system a window into the same kernel state so it can manage usb0.
-m configfs:/sys/kernel/config:configfs:nodev,noexec,nosuid:

# Subpartitions of /dev/mmcblk0p62 created by the citronics initramfs
# via kpartx. Boot partition is read-only; application data is f2fs and
# auto-formatted by nerves_runtime on first boot if invalid.
-m /dev/mmcblk0p62p1:/boot:ext2:ro,nodev,noexec,nosuid:
-m /dev/mmcblk0p62p3:/root:f2fs:nodev:

# Read-only Android partitions the ADSP firmware setup needs. The
# `ex_hexagonfs` library then mirrors selected files under
# /mnt/vendor and /mnt/dsp into /run/qcom/... at boot.
-m /dev/mmcblk0p32:/mnt/vendor:auto:ro,nodev,noexec,nosuid:
-m /dev/mmcblk0p34:/mnt/persist:ext4:ro,nodev,noexec,nosuid:
-m /dev/mmcblk0p13:/mnt/dsp:auto:ro,nodev,noexec,nosuid:

# Erlang release search path
-r /srv/erlang

# Hostname of the form "nerves-<last 4 chars of serial number>"
-d /usr/bin/boardid
-n nerves-%-.4s

# If using shoehorn, start the shoehorn OTP release first
--boot shoehorn
