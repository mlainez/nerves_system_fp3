+int Agc::init(IPAContext &context, [[maybe_unused]] const ValueNode &tuningData)
+{
+	context.ctrlMap[&controls::ExposureTimeMode] =
+		ControlInfo({ { ControlValue(controls::ExposureTimeModeAuto),
+				ControlValue(controls::ExposureTimeModeManual) } },
+			    ControlValue(controls::ExposureTimeModeAuto));
+	context.ctrlMap[&controls::ExposureTime] =
+		ControlInfo(int32_t{ 1 }, int32_t{ 1000000 }, int32_t{ 10000 });
+	context.ctrlMap[&controls::AnalogueGainMode] =
+		ControlInfo({ { ControlValue(controls::AnalogueGainModeAuto),
+				ControlValue(controls::AnalogueGainModeManual) } },
+			    ControlValue(controls::AnalogueGainModeAuto));
+	context.ctrlMap[&controls::AnalogueGain] = ControlInfo(1.0f, 64.0f, 1.0f);
+
+	return 0;
+}
+
+void Agc::queueRequest(IPAContext &context, [[maybe_unused]] const uint32_t frame,
+		       [[maybe_unused]] IPAFrameContext &frameContext,
+		       const ControlList &controls)
+{
+	auto &agc = context.activeState.agc;
+
+	/* A value applies in manual mode, given in this request or before */
+	const auto &exposureMode = controls.get(controls::ExposureTimeMode);
+	bool manualExposure = exposureMode ? *exposureMode == controls::ExposureTimeModeManual
+					   : agc.manualExposureTime.has_value();
+	const auto &exposureTime = controls.get(controls::ExposureTime);
+	if (!manualExposure)
+		agc.manualExposureTime.reset();
+	else if (exposureTime)
+		agc.manualExposureTime = *exposureTime;
+
+	const auto &gainMode = controls.get(controls::AnalogueGainMode);
+	bool manualGain = gainMode ? *gainMode == controls::AnalogueGainModeManual
+				   : agc.manualGain.has_value();
+	const auto &gain = controls.get(controls::AnalogueGain);
+	if (!manualGain)
+		agc.manualGain.reset();
+	else if (gain)
+		agc.manualGain = *gain;
+}
