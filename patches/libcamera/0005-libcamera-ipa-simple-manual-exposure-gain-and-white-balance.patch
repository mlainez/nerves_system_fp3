+class CameraSensorHelperS5kgm1sp : public CameraSensorHelper
+{
+public:
+	CameraSensorHelperS5kgm1sp()
+	{
+		/* Analogue gain code 32 is 1x */
+		gain_ = AnalogueGainLinear{ 1, 0, 0, 32 };
+	}
+};
+REGISTER_CAMERA_SENSOR_HELPER("s5kgm1sp", CameraSensorHelperS5kgm1sp)
+
+class CameraSensorHelperS5k3p9sp : public CameraSensorHelper
+{
+public:
+	CameraSensorHelperS5k3p9sp()
+	{
+		/* Analogue gain code 32 is 1x */
+		gain_ = AnalogueGainLinear{ 1, 0, 0, 32 };
+	}
+};
+REGISTER_CAMERA_SENSOR_HELPER("s5k3p9sp", CameraSensorHelperS5k3p9sp)
