 namespace ipa::soft::algorithms {
 
+int Awb::init(IPAContext &context, [[maybe_unused]] const ValueNode &tuningData)
+{
+	context.ctrlMap[&controls::AwbEnable] = ControlInfo(false, true, true);
+	context.ctrlMap[&controls::ColourGains] = ControlInfo(0.25f, 4.0f, 1.0f);
+
+	return 0;
+}
+
+void Awb::queueRequest(IPAContext &context, [[maybe_unused]] const uint32_t frame,
+		       [[maybe_unused]] IPAFrameContext &frameContext,
+		       const ControlList &controls)
+{
+	auto &awb = context.activeState.awb;
+
+	const auto &enable = controls.get(controls::AwbEnable);
+	if (enable)
+		awb.manual = !*enable;
+
+	/* Red and blue gains relative to green, applied while AWB is off */
+	const auto &colourGains = controls.get(controls::ColourGains);
+	if (colourGains && awb.manual)
+		awb.gains = { { (*colourGains)[0], 1.0f, (*colourGains)[1] } };
+}
