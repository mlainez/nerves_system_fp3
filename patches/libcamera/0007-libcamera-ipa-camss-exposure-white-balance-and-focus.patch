+/* The frame length goes first: the sensor bounds exposure by it. */
+void CamssCameraData::setSensorControls(const ControlList &sensorControls)
+{
+	ControlList frame(sensor_->controls());
+	ControlList rest(sensor_->controls());
+
+	for (const auto &[id, value] : sensorControls) {
+		if (id == V4L2_CID_VBLANK)
+			frame.set(id, value);
+		else
+			rest.set(id, value);
+	}
+
+	if (!frame.empty())
+		sensor_->setControls(&frame);
+	if (!rest.empty())
+		sensor_->setControls(&rest);
+}
+
+void CamssCameraData::setLensControls(const ControlList &lensControls)
+{
+	CameraLens *lens = sensor_->focusLens();
+	if (!lens || !lensControls.contains(V4L2_CID_FOCUS_ABSOLUTE))
+		return;
+
+	lens->setFocusPosition(lensControls.get(V4L2_CID_FOCUS_ABSOLUTE).get<int32_t>());
+}
+
+void CamssCameraData::setWbGains(uint32_t red, uint32_t blue)
+{
+	ControlList ctrls(pix_->controls());
+	ctrls.set(V4L2_CID_RED_BALANCE, static_cast<int32_t>(red));
+	ctrls.set(V4L2_CID_BLUE_BALANCE, static_cast<int32_t>(blue));
+	pix_->setControls(&ctrls);
+}
+
+void CamssCameraData::metadataReady(unsigned int frame, const ControlList &metadata)
+{
+	auto it = waiting_.find(frame);
+	if (it == waiting_.end())
+		return;
+
+	Request *request = it->second;
+	waiting_.erase(it);
+
+	request->_d()->metadata().merge(metadata);
+	pipe()->completeRequest(request);
+}
