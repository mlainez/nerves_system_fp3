diff -ruN a/src/ipa/camss/camss.cpp b/src/ipa/camss/camss.cpp
--- a/src/ipa/camss/camss.cpp
+++ b/src/ipa/camss/camss.cpp
@@ -0,0 +1,467 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Image processing algorithms for the Qualcomm camss VFE pixel path
+ *
+ * The VFE debayers, white balances, colour corrects and gamma corrects in
+ * hardware. This IPA regulates what it cannot: the sensor's exposure time,
+ * analogue gain and frame length, the VFE white balance gains, and the lens
+ * position. Each of them follows the application's manual value when it
+ * sets one.
+ */
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <memory>
+#include <optional>
+#include <stdint.h>
+#include <vector>
+
+#include <linux/v4l2-controls.h>
+
+#include <libcamera/base/file.h>
+#include <libcamera/base/log.h>
+#include <libcamera/base/utils.h>
+
+#include <libcamera/control_ids.h>
+#include <libcamera/controls.h>
+
+#include <libcamera/ipa/camss_ipa_interface.h>
+#include <libcamera/ipa/ipa_interface.h>
+#include <libcamera/ipa/ipa_module_info.h>
+
+#include "libcamera/internal/yaml_parser.h"
+
+#include "libipa/camera_sensor_helper.h"
+
+namespace libcamera {
+
+LOG_DEFINE_CATEGORY(IPACamss)
+
+using namespace std::literals::chrono_literals;
+
+namespace ipa::camss {
+
+namespace {
+
+/* Mean linear luminance exposure aims for: mid grey */
+constexpr double kTarget = 0.18;
+
+/* Share of pixels in the top luminance bin exposure backs off from */
+constexpr double kClipped = 0.02;
+
+/* Fraction of the correction, in log space, applied per adjustment */
+constexpr double kAgcSpeed = 0.6;
+constexpr double kAwbSpeed = 0.3;
+
+/* Frames a sensor change takes to show in the statistics */
+constexpr unsigned int kSensorDelay = 2;
+
+constexpr double kGainMax = 16.0;
+constexpr double kWbMin = 1.0;
+constexpr double kWbMax = 3.99;
+
+/* VFE white balance gains are Q7 */
+constexpr double kWbUnit = 128.0;
+
+/* Lens positions in dioptres, the driver's focus range in steps */
+constexpr float kLensDioptresMax = 10.0f;
+
+constexpr utils::Duration kDefaultFrameDuration = 33333us;
+
+} /* namespace */
+
+class IPACamss : public IPACamssInterface
+{
+public:
+	int init(const IPASettings &settings,
+		 const IPACameraSensorInfo &sensorInfo,
+		 const ControlInfoMap &sensorControls,
+		 const ControlInfoMap &lensControls,
+		 ControlInfoMap *ipaControls) override;
+	int configure(const IPAConfigInfo &configInfo) override;
+
+	int start(const ControlList &controls) override;
+	void stop() override {}
+
+	void queueRequest(const uint32_t frame, const ControlList &controls) override;
+	void processStats(const uint32_t frame, const IPACamssStats &stats,
+			  const ControlList &sensorControls) override;
+
+private:
+	bool applyControls(const ControlList &controls);
+	void setFrameDuration(utils::Duration duration);
+	int32_t exposureMax() const;
+
+	void expose(const IPACamssStats &stats);
+	void balance(const IPACamssStats &stats);
+
+	void writeSensor();
+	void writeWb();
+	void writeLens();
+
+	std::unique_ptr<CameraSensorHelper> camHelper_;
+	ControlInfoMap sensorControls_;
+	ControlInfoMap lensControls_;
+	int32_t lensMax_ = 0;
+
+	/* Sensor mode */
+	utils::Duration lineDuration_;
+	int32_t height_ = 0;
+	int32_t vblankMin_ = 0;
+	int32_t vblankMax_ = 0;
+	int32_t exposureMin_ = 1;
+	int32_t exposureMargin_ = 0;
+	double gainMin_ = 1.0;
+	double gainMax_ = kGainMax;
+
+	/* What the sensor, VFE and lens are set to */
+	int32_t vblank_ = 0;
+	int32_t exposure_ = 0;
+	double gain_ = 1.0;
+	double wbRed_ = 1.0;
+	double wbBlue_ = 1.0;
+	std::optional<float> lensPosition_;
+
+	bool autoExposure_ = true;
+	bool autoGain_ = true;
+	bool autoWb_ = true;
+	unsigned int settle_ = 0;
+
+	double initialRed_ = 1.8;
+	double initialBlue_ = 1.7;
+};
+
+int IPACamss::init(const IPASettings &settings,
+		   [[maybe_unused]] const IPACameraSensorInfo &sensorInfo,
+		   const ControlInfoMap &sensorControls,
+		   const ControlInfoMap &lensControls,
+		   ControlInfoMap *ipaControls)
+{
+	camHelper_ = CameraSensorHelperFactoryBase::create(settings.sensorModel);
+	if (!camHelper_)
+		LOG(IPACamss, Warning)
+			<< "No sensor helper for " << settings.sensorModel
+			<< ", gains are raw codes";
+
+	if (sensorControls.find(V4L2_CID_EXPOSURE) == sensorControls.end() ||
+	    sensorControls.find(V4L2_CID_ANALOGUE_GAIN) == sensorControls.end() ||
+	    sensorControls.find(V4L2_CID_VBLANK) == sensorControls.end()) {
+		LOG(IPACamss, Error) << "The sensor lacks exposure, gain or blanking controls";
+		return -EINVAL;
+	}
+
+	/* White balance gains to start from, from the tuning file */
+	File file(settings.configurationFile);
+	if (file.open(File::OpenModeFlag::ReadOnly)) {
+		std::unique_ptr<ValueNode> data = YamlParser::parse(file);
+		if (data && data->contains("awb")) {
+			const ValueNode &awb = (*data)["awb"];
+			initialRed_ = awb["initialRed"].get<double>(initialRed_);
+			initialBlue_ = awb["initialBlue"].get<double>(initialBlue_);
+		}
+	}
+
+	ControlInfoMap::Map ctrls;
+
+	ctrls[&controls::ExposureTimeMode] =
+		ControlInfo({ { ControlValue(controls::ExposureTimeModeAuto),
+				ControlValue(controls::ExposureTimeModeManual) } },
+			    ControlValue(controls::ExposureTimeModeAuto));
+	ctrls[&controls::ExposureTime] =
+		ControlInfo(int32_t{ 1 }, int32_t{ 1000000 }, int32_t{ 10000 });
+	ctrls[&controls::AnalogueGainMode] =
+		ControlInfo({ { ControlValue(controls::AnalogueGainModeAuto),
+				ControlValue(controls::AnalogueGainModeManual) } },
+			    ControlValue(controls::AnalogueGainModeAuto));
+	ctrls[&controls::AnalogueGain] = ControlInfo(1.0f, static_cast<float>(kGainMax), 1.0f);
+	ctrls[&controls::AwbEnable] = ControlInfo(false, true, true);
+	ctrls[&controls::ColourGains] =
+		ControlInfo(static_cast<float>(kWbMin), static_cast<float>(kWbMax), 1.0f);
+	ctrls[&controls::FrameDurationLimits] =
+		ControlInfo(int64_t{ 1000 }, int64_t{ 1000000 },
+			    static_cast<int64_t>(kDefaultFrameDuration.get<std::micro>()));
+
+	auto focus = lensControls.find(V4L2_CID_FOCUS_ABSOLUTE);
+	if (focus != lensControls.end()) {
+		lensControls_ = lensControls;
+		lensMax_ = focus->second.max().get<int32_t>();
+		ctrls[&controls::LensPosition] = ControlInfo(0.0f, kLensDioptresMax, 0.0f);
+		static const std::array<ControlValue, 1> afModes = {
+			ControlValue(controls::AfModeManual)
+		};
+		ctrls[&controls::AfMode] =
+			ControlInfo(afModes, ControlValue(controls::AfModeManual));
+	}
+
+	*ipaControls = ControlInfoMap(std::move(ctrls), controls::controls);
+
+	return 0;
+}
+
+int IPACamss::configure(const IPAConfigInfo &configInfo)
+{
+	const IPACameraSensorInfo &info = configInfo.sensorInfo;
+	sensorControls_ = configInfo.sensorControls;
+
+	lineDuration_ = info.minLineLength * 1.0s / info.pixelRate;
+	height_ = info.outputSize.height;
+
+	const ControlInfo &vblank = sensorControls_.find(V4L2_CID_VBLANK)->second;
+	const ControlInfo &exposure = sensorControls_.find(V4L2_CID_EXPOSURE)->second;
+	const ControlInfo &gain = sensorControls_.find(V4L2_CID_ANALOGUE_GAIN)->second;
+
+	vblankMin_ = vblank.min().get<int32_t>();
+	vblankMax_ = vblank.max().get<int32_t>();
+	exposureMin_ = std::max(exposure.min().get<int32_t>(), 1);
+
+	/* The exposure limit trails the frame length by a sensor margin */
+	exposureMargin_ = std::max(height_ + vblank.def().get<int32_t>() -
+					   exposure.max().get<int32_t>(),
+				   0);
+
+	if (camHelper_) {
+		gainMin_ = std::max(camHelper_->gain(gain.min().get<int32_t>()), 1.0);
+		gainMax_ = std::min(camHelper_->gain(gain.max().get<int32_t>()), kGainMax);
+	}
+
+	setFrameDuration(kDefaultFrameDuration);
+	exposure_ = exposureMax() / 2;
+	gain_ = gainMin_;
+	wbRed_ = initialRed_;
+	wbBlue_ = initialBlue_;
+	settle_ = 0;
+
+	return 0;
+}
+
+int IPACamss::start(const ControlList &controls)
+{
+	applyControls(controls);
+	writeSensor();
+	writeWb();
+	writeLens();
+
+	return 0;
+}
+
+void IPACamss::queueRequest([[maybe_unused]] const uint32_t frame,
+			    const ControlList &controls)
+{
+	if (applyControls(controls)) {
+		writeSensor();
+		writeWb();
+		writeLens();
+	}
+}
+
+void IPACamss::processStats(const uint32_t frame, const IPACamssStats &stats,
+			    [[maybe_unused]] const ControlList &sensorControls)
+{
+	if (!stats.histogram.empty()) {
+		expose(stats);
+		balance(stats);
+	}
+
+	ControlList metadata(controls::controls);
+	metadata.set(controls::ExposureTime,
+		     static_cast<int32_t>(utils::Duration(exposure_ * lineDuration_).get<std::micro>()));
+	metadata.set(controls::AnalogueGain, static_cast<float>(gain_));
+	metadata.set(controls::ColourGains, { static_cast<float>(wbRed_),
+					      static_cast<float>(wbBlue_) });
+	metadata.set(controls::FrameDuration,
+		     static_cast<int64_t>(utils::Duration((height_ + vblank_) * lineDuration_).get<std::micro>()));
+	if (lensPosition_)
+		metadata.set(controls::LensPosition, *lensPosition_);
+
+	metadataReady.emit(frame, metadata);
+}
+
+/* Returns whether any setting changed. */
+bool IPACamss::applyControls(const ControlList &controls)
+{
+	bool changed = false;
+
+	const auto &limits = controls.get(controls::FrameDurationLimits);
+	if (limits) {
+		setFrameDuration((*limits)[1] * 1us);
+		changed = true;
+	}
+
+	const auto &exposureMode = controls.get(controls::ExposureTimeMode);
+	if (exposureMode) {
+		autoExposure_ = *exposureMode == controls::ExposureTimeModeAuto;
+		changed = true;
+	}
+
+	const auto &exposureTime = controls.get(controls::ExposureTime);
+	if (exposureTime && !autoExposure_) {
+		exposure_ = std::clamp<int32_t>(std::lround(*exposureTime * 1us / lineDuration_),
+						exposureMin_, exposureMax());
+		changed = true;
+	}
+
+	const auto &gainMode = controls.get(controls::AnalogueGainMode);
+	if (gainMode) {
+		autoGain_ = *gainMode == controls::AnalogueGainModeAuto;
+		changed = true;
+	}
+
+	const auto &gain = controls.get(controls::AnalogueGain);
+	if (gain && !autoGain_) {
+		gain_ = std::clamp<double>(*gain, gainMin_, gainMax_);
+		changed = true;
+	}
+
+	const auto &awbEnable = controls.get(controls::AwbEnable);
+	if (awbEnable) {
+		autoWb_ = *awbEnable;
+		changed = true;
+	}
+
+	const auto &colourGains = controls.get(controls::ColourGains);
+	if (colourGains && !autoWb_) {
+		wbRed_ = std::clamp<double>((*colourGains)[0], kWbMin, kWbMax);
+		wbBlue_ = std::clamp<double>((*colourGains)[1], kWbMin, kWbMax);
+		changed = true;
+	}
+
+	const auto &lensPosition = controls.get(controls::LensPosition);
+	if (lensPosition && lensMax_) {
+		lensPosition_ = std::clamp(*lensPosition, 0.0f, kLensDioptresMax);
+		changed = true;
+	}
+
+	return changed;
+}
+
+/* The longest frame the limits allow, which leaves the most exposure time */
+void IPACamss::setFrameDuration(utils::Duration duration)
+{
+	int32_t lines = duration / lineDuration_;
+	vblank_ = std::clamp(lines - height_, vblankMin_, vblankMax_);
+	exposure_ = std::min(exposure_, exposureMax());
+}
+
+int32_t IPACamss::exposureMax() const
+{
+	return std::max(height_ + vblank_ - exposureMargin_, exposureMin_);
+}
+
+/* Exposure time first, up to the frame length, then analogue gain. */
+void IPACamss::expose(const IPACamssStats &stats)
+{
+	if (!autoExposure_ && !autoGain_)
+		return;
+
+	if (settle_) {
+		settle_--;
+		return;
+	}
+
+	const std::vector<uint32_t> &hist = stats.histogram;
+	uint64_t total = 0;
+	double sum = 0;
+	for (unsigned int i = 0; i < hist.size(); i++) {
+		total += hist[i];
+		sum += hist[i] * (i + 0.5) / hist.size();
+	}
+	if (!total)
+		return;
+
+	double mean = sum / total;
+	double clipped = static_cast<double>(hist.back()) / total;
+
+	double ratio = std::clamp(kTarget / std::max(mean, 1e-4), 0.25, 4.0);
+	if (clipped > kClipped)
+		ratio = std::min(ratio, 0.8);
+
+	double target = exposure_ * gain_ * std::pow(ratio, kAgcSpeed);
+	int32_t exposure = exposure_;
+	double gain = gain_;
+
+	if (autoExposure_) {
+		double rest = autoGain_ ? gainMin_ : gain_;
+		exposure = std::clamp<int32_t>(std::lround(target / rest), exposureMin_,
+					       exposureMax());
+	}
+
+	if (autoGain_)
+		gain = std::clamp(target / exposure, gainMin_, gainMax_);
+
+	if (std::abs(exposure * gain / (exposure_ * gain_) - 1.0) < 0.03)
+		return;
+
+	exposure_ = exposure;
+	gain_ = gain;
+	writeSensor();
+	settle_ = kSensorDelay;
+}
+
+/* Grey world: the mean of the mid tones should be neutral. */
+void IPACamss::balance(const IPACamssStats &stats)
+{
+	if (!autoWb_ || stats.r <= 0 || stats.g <= 0 || stats.b <= 0)
+		return;
+
+	double red = std::clamp(wbRed_ * std::pow(stats.g / stats.r, kAwbSpeed), kWbMin, kWbMax);
+	double blue = std::clamp(wbBlue_ * std::pow(stats.g / stats.b, kAwbSpeed), kWbMin, kWbMax);
+
+	if (std::abs(red / wbRed_ - 1.0) < 0.01 && std::abs(blue / wbBlue_ - 1.0) < 0.01)
+		return;
+
+	wbRed_ = red;
+	wbBlue_ = blue;
+	writeWb();
+}
+
+void IPACamss::writeSensor()
+{
+	int32_t code = camHelper_ ? camHelper_->gainCode(gain_) : std::lround(gain_);
+
+	ControlList ctrls(sensorControls_);
+	ctrls.set(V4L2_CID_VBLANK, vblank_);
+	ctrls.set(V4L2_CID_EXPOSURE, exposure_);
+	ctrls.set(V4L2_CID_ANALOGUE_GAIN, code);
+
+	setSensorControls.emit(ctrls);
+}
+
+void IPACamss::writeWb()
+{
+	setWbGains.emit(std::lround(wbRed_ * kWbUnit), std::lround(wbBlue_ * kWbUnit));
+}
+
+void IPACamss::writeLens()
+{
+	if (!lensPosition_ || !lensMax_)
+		return;
+
+	ControlList ctrls(lensControls_);
+	ctrls.set(V4L2_CID_FOCUS_ABSOLUTE,
+		  static_cast<int32_t>(std::lround(*lensPosition_ / kLensDioptresMax * lensMax_)));
+
+	setLensControls.emit(ctrls);
+}
+
+} /* namespace ipa::camss */
+
+/*
+ * External IPA module interface
+ */
+extern "C" {
+const struct IPAModuleInfo ipaModuleInfo = {
+	IPA_MODULE_API_VERSION,
+	0,
+	"camss",
+	"camss",
+};
+
+IPAInterface *ipaCreate()
+{
+	return new ipa::camss::IPACamss();
+}
+
+} /* extern "C" */
+
+} /* namespace libcamera */
