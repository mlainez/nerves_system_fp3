From: Marc Lainez <marc.lainez@gmail.com>
Subject: [PATCH] libcamera: ipa: camss: exposure, white balance and focus

Add an IPA for the camss pipeline handler. It regulates the sensor's
exposure time, analogue gain and frame length, the VFE white balance
gains and the lens position, each from the application's manual value
when it sets one: ExposureTimeMode, ExposureTime, AnalogueGainMode,
AnalogueGain, AwbEnable, ColourGains, FrameDurationLimits, AfMode and
LensPosition.

Auto exposure aims the mean linear luminance at mid grey and backs off
from clipping; auto white balance is grey world. The pipeline handler
feeds both from a grid of samples of each NV12 output frame.

Assisted-by: Claude:claude-opus-5-5
---
diff -ruN a/include/libcamera/ipa/camss.mojom b/include/libcamera/ipa/camss.mojom
--- a/include/libcamera/ipa/camss.mojom
+++ b/include/libcamera/ipa/camss.mojom
@@ -0,0 +1,49 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+
+/*
+ * \todo Document the interface and remove the related EXCLUDE_PATTERNS entry.
+ */
+
+module ipa.camss;
+
+import "include/libcamera/ipa/core.mojom";
+
+struct IPAConfigInfo {
+	libcamera.IPACameraSensorInfo sensorInfo;
+	libcamera.ControlInfoMap sensorControls;
+	libcamera.ControlInfoMap lensControls;
+};
+
+/*
+ * Statistics of a frame: the mean linear R, G and B of its mid tones, and
+ * a histogram of its linear luminance.
+ */
+struct IPACamssStats {
+	float r;
+	float g;
+	float b;
+	array<uint32> histogram;
+};
+
+interface IPACamssInterface {
+	init(libcamera.IPASettings settings,
+	     libcamera.IPACameraSensorInfo sensorInfo,
+	     libcamera.ControlInfoMap sensorControls,
+	     libcamera.ControlInfoMap lensControls)
+		=> (int32 ret, libcamera.ControlInfoMap ipaControls);
+	configure(IPAConfigInfo configInfo) => (int32 ret);
+
+	start(libcamera.ControlList controls) => (int32 ret);
+	stop();
+
+	[async] queueRequest(uint32 frame, libcamera.ControlList controls);
+	[async] processStats(uint32 frame, IPACamssStats stats,
+			     libcamera.ControlList sensorControls);
+};
+
+interface IPACamssEventInterface {
+	setSensorControls(libcamera.ControlList sensorControls);
+	setLensControls(libcamera.ControlList lensControls);
+	setWbGains(uint32 red, uint32 blue);
+	metadataReady(uint32 frame, libcamera.ControlList metadata);
+};
