+/* Linear light of an 8-bit value encoded with the VFE gamma 2.2 curve */
+float linear(int value)
+{
+	static const std::array<float, 256> table = [] {
+		std::array<float, 256> t;
+		for (unsigned int i = 0; i < t.size(); i++)
+			t[i] = std::pow(i / 255.0f, 2.2f);
+		return t;
+	}();
+
+	return table[std::clamp(value, 0, 255)];
+}
+
+/*
+ * Mean linear R, G and B of the mid tones and a histogram of linear
+ * luminance, from a grid of samples of an NV12 frame.
+ */
+ipa::camss::IPACamssStats frameStats(const uint8_t *y, const uint8_t *uv,
+				     const Size &size, unsigned int stride)
+{
+	ipa::camss::IPACamssStats stats{};
+	stats.histogram.assign(kHistogramBins, 0);
+
+	double r = 0, g = 0, b = 0;
+	unsigned int count = 0;
+
+	for (unsigned int row = 0; row < kStatsRows; row++) {
+		unsigned int line = ((2 * row + 1) * size.height / (2 * kStatsRows)) & ~1U;
+
+		for (unsigned int col = 0; col < kStatsColumns; col++) {
+			unsigned int x = ((2 * col + 1) * size.width / (2 * kStatsColumns)) & ~1U;
+			int luma = y[line * stride + x];
+			int u = uv[line / 2 * stride + x] - 128;
+			int v = uv[line / 2 * stride + x + 1] - 128;
+
+			float l = linear(luma);
+			unsigned int bin = std::min<unsigned int>(l * kHistogramBins,
+								  kHistogramBins - 1);
+			stats.histogram[bin]++;
+
+			if (luma < 30 || luma > 230)
+				continue;
+
+			r += linear(std::lround(luma + 1.402 * v));
+			g += linear(std::lround(luma - 0.344 * u - 0.714 * v));
+			b += linear(std::lround(luma + 1.772 * u));
+			count++;
+		}
+	}
+
+	if (count) {
+		stats.r = r / count;
+		stats.g = g / count;
+		stats.b = b / count;
+	}
+
+	return stats;
+}
