diff --git a/arch/arm/dts/sdm632-fairphone-fp3-u-boot.dtsi b/arch/arm/dts/sdm632-fairphone-fp3-u-boot.dtsi
new file mode 100644
index 00000000000..3afb229b4c7
--- /dev/null
+++ b/arch/arm/dts/sdm632-fairphone-fp3-u-boot.dtsi
@@ -0,0 +1,46 @@
+// SPDX-License-Identifier: GPL-2.0
+
+/ {
+	/*
+	 * Match the Fairphone 3 entry of the stock LK so it selects this DTB
+	 * when U-Boot is packed into an Android boot image.
+	 */
+	qcom,board-id = <8 3>;
+	qcom,pmic-id = <0x10016 0x25 0x00 0x00>;
+};
+
+&tlmm {
+	/* The UART is probed before relocation, its pins must be set up by then */
+	bootph-all;
+
+	uart_console_pullup: uart-console-pullup-state {
+		bootph-all;
+
+		tx-pins {
+			bootph-all;
+			pins = "gpio4";
+			function = "blsp_uart2";
+			drive-strength = <2>;
+			bias-disable;
+		};
+
+		/* The debug UART pads are usually left unconnected */
+		rx-pins {
+			bootph-all;
+			pins = "gpio5";
+			function = "blsp_uart2";
+			drive-strength = <2>;
+			bias-pull-up;
+		};
+	};
+};
+
+/* The PRNG is owned by the secure world, any access from U-Boot traps */
+&{/soc@0/rng@e3000} {
+	status = "disabled";
+};
+
+&uart_0 {
+	pinctrl-0 = <&uart_console_pullup>;
+	pinctrl-names = "default";
+};
