From: nerves_system_fp3 <root@localhost>
Date: 2026-05-16
Subject: [PATCH] arm64: dts: qcom: sdm632-fairphone-fp3p: add ramoops node

lk2nd-msm8953 reserves 512 KiB at 0xbfe80000 and exposes the contents
via `fastboot oem ramoops {raw,console,dump}` after a reboot. Without
a matching reserved-memory node in the DTB the kernel never writes
its log buffer to that region, so post-panic introspection from the
host is impossible.

This is the same layout msm8953-asus-common.dtsi uses, and it matches
the bytes lk2nd is already prepared to read from.

Signed-off-by: nerves_system_fp3 <root@localhost>
---
 arch/arm64/boot/dts/qcom/sdm632-fairphone-fp3p.dts | 12 ++++++++++++
 1 file changed, 12 insertions(+)

--- a/arch/arm64/boot/dts/qcom/sdm632-fairphone-fp3p.dts
+++ b/arch/arm64/boot/dts/qcom/sdm632-fairphone-fp3p.dts
@@ -34,6 +34,18 @@
 		stdout-path = "serial0:115200n8";
 	};

+	reserved-memory {
+		ramoops@bfe80000 {
+			compatible = "ramoops";
+			reg = <0x0 0xbfe80000 0x0 0x80000>;
+			console-size = <0x40000>;
+			record-size = <0x2000>;
+			pmsg-size = <0x0>;
+			ftrace-size = <0x0>;
+			dump-size = <0x3e000>;
+		};
+	};
+
 	gpio-keys {
 		compatible = "gpio-keys";

