From ba081357bdbc23e51cfe4101e6bcf2625ea90b1f Mon Sep 17 00:00:00 2001
From: Christophe De Troyer <christophe.detroyer@gmail.com>
Date: Tue, 13 Oct 2026 11:18:02 +0200
Subject: [PATCH] power: supply: qcom_qg: count charge between OCV measurements

The capacity was looked up from the cached OCV only. That OCV is read
once at probe (the PON OCV) and refreshed only by the good-ocv IRQ,
which the hardware raises after the battery has rested. A system that
never suspends, or that is charging, therefore reports the power-on
capacity until the next OCV: a phone booted on a flat battery shows
0% while it charges at 2 A.

Integrate the burst-average current every 10 s on top of the charge
derived from the last OCV, and report the capacity from that counter.
Every new good OCV re-anchors the counter. Raise power_supply_changed()
when the integer capacity changes, so that userspace sees the update
without polling. Expose the counter as CHARGE_NOW.

The S2 running average is not used: it stops updating once the FSM has
gone to its sleep states, e.g. after charge termination, and then reads
0 mA while the battery discharges. The burst average reads 0x8000 until
the first measurement after power-on; report that as -ENODATA rather
than a 5 A current.

Boards without charge-full-design-microamp-hours keep the OCV-only
capacity.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/power/supply/qcom_qg.c | 170 +++++++++++++++++++++++++++++----
 1 file changed, 149 insertions(+), 21 deletions(-)

diff --git a/drivers/power/supply/qcom_qg.c b/drivers/power/supply/qcom_qg.c
index a3420fd..7e8317d 100644
--- a/drivers/power/supply/qcom_qg.c
+++ b/drivers/power/supply/qcom_qg.c
@@ -9,11 +9,14 @@
  * sleep states, and coulomb counting through V/I accumulators.
  *
  * This driver exposes battery state via the power_supply subsystem.
- * SOC is computed in-kernel using OCV-to-capacity lookup tables from
- * the monitored-battery simple-battery node.
+ * SOC is computed in-kernel: an OCV measurement is converted to a charge
+ * using the OCV-to-capacity lookup tables from the monitored-battery
+ * simple-battery node, and the battery current is integrated on top of
+ * that until the next OCV measurement.
  */
 
 #include <linux/cleanup.h>
+#include <linux/devm-helpers.h>
 #include <linux/errno.h>
 #include <linux/iio/consumer.h>
 #include <linux/interrupt.h>
@@ -25,6 +28,7 @@
 #include <linux/property.h>
 #include <linux/regmap.h>
 #include <linux/timekeeping.h>
+#include <linux/workqueue.h>
 
 /* Peripheral type register */
 #define QG_PERPH_TYPE			0x04
@@ -91,6 +95,14 @@
  */
 #define QG_OCV_STALE_SECS		180
 
+/*
+ * Interval at which the battery current is sampled and integrated into
+ * the charge counter. Good OCVs are only measured while the battery
+ * rests (in suspend), so a system that stays awake depends on the
+ * counter for every SOC change after power-on.
+ */
+#define QG_CC_INTERVAL_MS		10000
+
 struct qcom_qg {
 	struct device *dev;
 	struct regmap *regmap;
@@ -109,6 +121,12 @@ struct qcom_qg {
 	unsigned int ocv_uv;
 	time64_t ocv_time;
 	bool batt_present;
+
+	/* Coulomb counter, protected by lock */
+	struct delayed_work cc_work;
+	s64 charge_uah;
+	ktime_t cc_time;
+	int capacity;
 };
 
 /* --- Low-level register helpers --- */
@@ -203,6 +221,10 @@ static int qg_read_ibat(struct qcom_qg *qg, int *ibat_ua)
 	if (ret)
 		return ret;
 
+	/* Nothing measured yet since power-on */
+	if (raw == QG_FIFO_RESET_VAL)
+		return -ENODATA;
+
 	/*
 	 * Hardware convention: positive = discharge, negative = charge.
 	 * Power supply class convention (ABI): positive = charge, negative = discharge.
@@ -293,6 +315,37 @@ release:
 	return ret;
 }
 
+/**
+ * qg_ocv_to_charge() - Reset the charge counter from the cached OCV.
+ *
+ * The OCV is the only absolute measure of the state of charge, so every
+ * new OCV discards whatever the counter has integrated since the last one.
+ * Must be called with the lock held.
+ */
+static void qg_ocv_to_charge(struct qcom_qg *qg)
+{
+	int full_uah, temp_decidegc, ret;
+
+	if (!qg->batt_info || !qg->ocv_uv)
+		return;
+
+	/* Try to get temperature for temperature-compensated lookup */
+	ret = qg_read_temperature(qg, &temp_decidegc);
+	if (ret)
+		temp_decidegc = 250; /* default 25.0 degC */
+
+	qg->capacity = power_supply_batinfo_ocv2cap(qg->batt_info, qg->ocv_uv,
+						    temp_decidegc);
+
+	/* Without a design capacity there is nothing to count against */
+	full_uah = qg->batt_info->charge_full_design_uah;
+	if (full_uah <= 0)
+		return;
+
+	qg->charge_uah = div_s64((s64)full_uah * qg->capacity, 100);
+	qg->cc_time = ktime_get_boottime();
+}
+
 /**
  * qg_update_ocv() - Read the latest good OCV if available.
  *
@@ -323,34 +376,79 @@ static int qg_update_ocv(struct qcom_qg *qg)
 
 	qg->ocv_uv = ocv_uv;
 	qg->ocv_time = ktime_get_seconds();
+	qg_ocv_to_charge(qg);
 
 	return 0;
 }
 
-static int qg_get_capacity(struct qcom_qg *qg, int *capacity)
+/**
+ * qg_cc_update() - Integrate the battery current into the charge counter.
+ *
+ * Uses the burst-average current. The S2 running average would smooth
+ * better, but it stops updating once the FSM has moved to its sleep
+ * states, which it does whenever the current drops low enough to take
+ * an OCV, e.g. at charge termination; after unplugging it then reads
+ * 0 mA while the battery discharges. Must be called with the lock held.
+ *
+ * Return: true if the integer capacity changed.
+ */
+static bool qg_cc_update(struct qcom_qg *qg)
 {
-	int temp_decidegc;
-	int ret;
+	int full_uah, capacity, ibat_ua, ret;
+	ktime_t now;
+	s64 dt_ms;
 
-	if (!qg->batt_info)
-		return -ENODATA;
+	if (!qg->batt_info || qg->batt_info->charge_full_design_uah <= 0)
+		return false;
+
+	ret = qg_read_ibat(qg, &ibat_ua);
+
+	now = ktime_get_boottime();
+	dt_ms = ktime_ms_delta(now, qg->cc_time);
+	qg->cc_time = now;
+
+	/* No current for this interval (e.g. just after power-on): drop it */
+	if (ret)
+		return false;
+
+	full_uah = qg->batt_info->charge_full_design_uah;
+	qg->charge_uah += div_s64((s64)ibat_ua * dt_ms, 3600 * 1000);
+	qg->charge_uah = clamp_t(s64, qg->charge_uah, 0, full_uah);
 
 	/*
-	 * If OCV is stale, fall back to using current voltage as a
-	 * rough approximation. This is less accurate under load but
-	 * better than reporting nothing.
+	 * Round, so that a counter anchored on a whole percentage does not
+	 * drop a point on the first microamp-hour drawn.
 	 */
-	if (!qg->ocv_uv)
-		return -ENODATA;
+	capacity = div_s64(qg->charge_uah * 100 + full_uah / 2, full_uah);
+	if (capacity == qg->capacity)
+		return false;
 
-	/* Try to get temperature for temperature-compensated lookup */
-	ret = qg_read_temperature(qg, &temp_decidegc);
-	if (ret)
-		temp_decidegc = 250; /* default 25.0 degC */
+	qg->capacity = capacity;
+	return true;
+}
 
-	*capacity = power_supply_batinfo_ocv2cap(qg->batt_info,
-						 qg->ocv_uv,
-						 temp_decidegc);
+static void qg_cc_work(struct work_struct *work)
+{
+	struct qcom_qg *qg = container_of(work, struct qcom_qg, cc_work.work);
+	bool changed = false;
+
+	scoped_guard(mutex, &qg->lock)
+		changed = qg->batt_present && qg_cc_update(qg);
+
+	if (changed)
+		power_supply_changed(qg->psy);
+
+	queue_delayed_work(system_freezable_wq, &qg->cc_work,
+			   msecs_to_jiffies(QG_CC_INTERVAL_MS));
+}
+
+static int qg_get_capacity(struct qcom_qg *qg, int *capacity)
+{
+	if (!qg->batt_info || !qg->ocv_uv)
+		return -ENODATA;
+
+	guard(mutex)(&qg->lock);
+	*capacity = qg->capacity;
 
 	return 0;
 }
@@ -450,7 +548,9 @@ static int qg_get_property(struct power_supply *psy,
 	case POWER_SUPPLY_PROP_CURRENT_NOW:
 		if (!qg->batt_present)
 			return -ENODATA;
-		ret = qg_read_ibat(qg, &qg->ibat_ua);
+		/* The counter work toggles the same burst-average hold */
+		scoped_guard(mutex, &qg->lock)
+			ret = qg_read_ibat(qg, &qg->ibat_ua);
 		if (ret)
 			return ret;
 		val->intval = qg->ibat_ua;
@@ -492,6 +592,14 @@ static int qg_get_property(struct power_supply *psy,
 		val->intval = qg->batt_info->voltage_min_design_uv;
 		return 0;
 
+	case POWER_SUPPLY_PROP_CHARGE_NOW:
+		if (!qg->batt_present || !qg->batt_info ||
+		    qg->batt_info->charge_full_design_uah <= 0)
+			return -ENODATA;
+		scoped_guard(mutex, &qg->lock)
+			val->intval = qg->charge_uah;
+		return 0;
+
 	case POWER_SUPPLY_PROP_CHARGE_FULL_DESIGN:
 		if (!qg->batt_info ||
 		    qg->batt_info->charge_full_design_uah < 0)
@@ -542,6 +650,7 @@ static enum power_supply_property qg_properties[] = {
 	POWER_SUPPLY_PROP_CURRENT_NOW,
 	POWER_SUPPLY_PROP_CURRENT_AVG,
 	POWER_SUPPLY_PROP_CAPACITY,
+	POWER_SUPPLY_PROP_CHARGE_NOW,
 	POWER_SUPPLY_PROP_CHARGE_FULL_DESIGN,
 	POWER_SUPPLY_PROP_TEMP,
 };
@@ -637,6 +746,17 @@ static int pmi632_qg_probe(struct platform_device *pdev)
 		return dev_err_probe(dev, ret,
 				     "Failed to get battery info\n");
 
+	/* Start counting from the PON OCV */
+	scoped_guard(mutex, &qg->lock)
+		qg_ocv_to_charge(qg);
+
+	ret = devm_delayed_work_autocancel(dev, &qg->cc_work, qg_cc_work);
+	if (ret)
+		return ret;
+
+	queue_delayed_work(system_freezable_wq, &qg->cc_work,
+			   msecs_to_jiffies(QG_CC_INTERVAL_MS));
+
 	/* Request IRQs */
 	irq = platform_get_irq_byname(pdev, "fifo-done");
 	if (irq >= 0) {
@@ -703,8 +823,16 @@ static int pmi632_qg_resume(struct device *dev)
 	 * the sleep state. Check for it and update our cached value.
 	 * Also refresh the battery voltage.
 	 */
-	scoped_guard(mutex, &qg->lock)
+	scoped_guard(mutex, &qg->lock) {
+		/*
+		 * The counter did not run while suspended. Integrating the
+		 * current read now over the whole suspend period would charge
+		 * the awake current for it, so restart the interval instead;
+		 * a good OCV from the sleep state re-anchors the counter.
+		 */
+		qg->cc_time = ktime_get_boottime();
 		qg_update_ocv(qg);
+	}
 
 	qg_read_vbat(qg, &qg->vbat_uv);
 
-- 
2.55.0

