Subject: freedreno/a5xx: implement emit_intrinsic_load/store_global_ir3

ir3_compiler_nir.c's emit_intrinsic() at line 2798 dereferences
ctx->funcs->emit_intrinsic_load_global_ir3 for any kernel that emits
nir_intrinsic_load_global_ir3. The funcs table for a4xx/a5xx
(ir3_a4xx_funcs in ir3_a4xx.c) leaves that field NULL, so every
Rusticl-compiled OpenCL kernel that touches a __global pointer
segfaults the Rusticl ir3qN compile worker with PC=0.

OpenGL ES 3.1 SSBO intrinsics use a different a4xx path
(emit_intrinsic_load_ssbo etc.) which IS implemented — that's why
GLES compute shaders work on a5xx but OpenCL didn't.

Port the implementations from ir3_a6xx.c using only the basic LDG /
STG instructions (cat6 opcodes 0 and 3, available since a3xx —
instr-a3xx.h). The LDG_A / STG_A variants with register offsets are
a6xx+ only (gated `#elif GPU >= 600` in ir3.h INSTR declarations),
so on a5xx we accept only the constant-offset form.

That's enough for Rusticl's typical NIR output: the lower_64b_global
pass in ir3_nir_lower_64b.c emits the offset as nir_imm_int(b, off)
where `off` is a small constant (vec-8/16 split index). Any kernel
whose lowering produces a non-constant offset will hit the
`unreachable` until someone wires up explicit 64-bit address
arithmetic for a5xx.

Identified via core-dump backtrace: addr2line on the lr offset
0x2c62ec inside libRusticlOpenCL.so resolved to
src/freedreno/ir3/ir3_compiler_nir.c:2798 in emit_intrinsic.

--- a/src/freedreno/ir3/ir3_a4xx.c
+++ b/src/freedreno/ir3/ir3_a4xx.c
@@ -383,6 +383,80 @@ emit_intrinsic_atomic_global(struct ir3_context *ctx, nir_intrinsic_instr *intr)
    unreachable("Global atomic are unimplemented on A5xx");
 }

+static void
+emit_intrinsic_load_global_ir3(struct ir3_context *ctx,
+                               nir_intrinsic_instr *intr,
+                               struct ir3_instruction **dst)
+{
+   struct ir3_builder *b = &ctx->build;
+   unsigned dest_components = nir_intrinsic_dest_components(intr);
+   struct ir3_instruction *addr;
+
+   addr = ir3_collect(b, ir3_get_src(ctx, &intr->src[0])[0],
+                      ir3_get_src(ctx, &intr->src[0])[1]);
+
+   /* a5xx has no LDG_A (register-offset variant — that's a6xx+ only,
+    * gated `#elif GPU >= 600` in ir3.h). The NIR lower_64b_global pass
+    * emits the offset as a constant via nir_imm_int, so const offset
+    * is the common case; bail loudly on anything else so the failure
+    * is obvious instead of silently miscompiling.
+    */
+   if (!nir_src_is_const(intr->src[1]) ||
+       nir_src_as_int(intr->src[1]) >= (1 << 8) ||
+       nir_src_as_int(intr->src[1]) <= -(1 << 8)) {
+      unreachable("a5xx load_global_ir3 with non-constant or "
+                  "out-of-immediate-range offset (LDG_A is a6xx+ only)");
+   }
+
+   struct ir3_instruction *load = ir3_LDG(
+      b, addr, 0,
+      create_immed(b, nir_src_as_int(intr->src[1]) * 4), 0,
+      create_immed(b, dest_components), 0);
+
+   load->cat6.type = type_uint_size(intr->def.bit_size);
+   load->dsts[0]->wrmask = MASK(dest_components);
+
+   load->barrier_class = IR3_BARRIER_BUFFER_R;
+   load->barrier_conflict = IR3_BARRIER_BUFFER_W;
+
+   ir3_split_dest(b, dst, load, 0, dest_components);
+}
+
+static void
+emit_intrinsic_store_global_ir3(struct ir3_context *ctx,
+                                nir_intrinsic_instr *intr)
+{
+   struct ir3_builder *b = &ctx->build;
+   struct ir3_instruction *value, *addr;
+   unsigned ncomp = nir_intrinsic_src_components(intr, 0);
+
+   addr = ir3_collect(b, ir3_get_src(ctx, &intr->src[1])[0],
+                      ir3_get_src(ctx, &intr->src[1])[1]);
+
+   value = ir3_create_collect(b, ir3_get_src(ctx, &intr->src[0]), ncomp);
+
+   if (!nir_src_is_const(intr->src[2]) ||
+       nir_src_as_int(intr->src[2]) >= (1 << 10) ||
+       nir_src_as_int(intr->src[2]) <= -(1 << 10)) {
+      unreachable("a5xx store_global_ir3 with non-constant or "
+                  "out-of-immediate-range offset (STG_A is a6xx+ only)");
+   }
+
+   struct ir3_instruction *stg = ir3_STG(
+      b, addr, 0,
+      create_immed(b, nir_src_as_int(intr->src[2]) * 4), 0,
+      value, 0,
+      create_immed(b, ncomp), 0);
+
+   stg->cat6.type = type_uint_size(intr->src[0].ssa->bit_size);
+   stg->cat6.iim_val = 1;
+
+   array_insert(ctx->block, ctx->block->keeps, stg);
+
+   stg->barrier_class = IR3_BARRIER_BUFFER_W;
+   stg->barrier_conflict = IR3_BARRIER_BUFFER_R | IR3_BARRIER_BUFFER_W;
+}
+
 const struct ir3_context_funcs ir3_a4xx_funcs = {
    .emit_intrinsic_load_ssbo = emit_intrinsic_load_ssbo,
    .emit_intrinsic_store_ssbo = emit_intrinsic_store_ssbo,
@@ -391,7 +465,7 @@ const struct ir3_context_funcs ir3_a4xx_funcs = {
    .emit_intrinsic_store_image = emit_intrinsic_store_image,
    .emit_intrinsic_atomic_image = emit_intrinsic_atomic_image,
    .emit_intrinsic_image_size = emit_intrinsic_image_size_tex,
-   .emit_intrinsic_load_global_ir3 = NULL,
-   .emit_intrinsic_store_global_ir3 = NULL,
+   .emit_intrinsic_load_global_ir3 = emit_intrinsic_load_global_ir3,
+   .emit_intrinsic_store_global_ir3 = emit_intrinsic_store_global_ir3,
    .emit_intrinsic_atomic_global = emit_intrinsic_atomic_global,
 };
