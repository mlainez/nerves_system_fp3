Subject: freedreno/a5xx: implement emit_intrinsic_load/store_global_ir3

The Freedreno IR3 compiler's funcs table for a4xx/a5xx
(ir3_a4xx_funcs) left .emit_intrinsic_load_global_ir3 and
.emit_intrinsic_store_global_ir3 as NULL. OpenGL ES 3.1 shaders use
SSBO intrinsics (load_ssbo/store_ssbo, which a4xx_funcs implements)
so the gap was harmless — but Rusticl-compiled OpenCL kernels emit
nir_intrinsic_load_global_ir3 / nir_intrinsic_store_global_ir3 for
__global pointer accesses, and ir3_compiler_nir.c's emit_intrinsic
dereferences the NULL function pointer at line 2798:

  case nir_intrinsic_load_global_ir3:
     ctx->funcs->emit_intrinsic_load_global_ir3(ctx, intr, dst);

Symptom on Adreno 506 (Fairphone 3+): every OpenCL kernel that reads
or writes a __global buffer segfaults the Rusticl ir3qN worker
thread with PC=0 inside ir3_compiler_nir.c emit_intrinsic at line
2798 (load) or 2795 (store).

Port the implementations verbatim from ir3_a6xx.c. The cat6 LDG /
STG / LDG_A / STG_A instruction macros have existed in the IR3 ISA
since a3xx (see instr-a3xx.h opc 0/3), so a5xx hardware can execute
them — only the IR3 emit path was missing. The a7xx-specific
SHL_B-by-2 offset preshift (gated by `compiler->gen >= 7` in the
a6xx version) is irrelevant on a5xx so it's dropped from the port.

With this, a simple vec_add OpenCL kernel compiles and dispatches
on Adreno 506.

--- a/src/freedreno/ir3/ir3_a4xx.c
+++ b/src/freedreno/ir3/ir3_a4xx.c
@@ -383,6 +383,85 @@ emit_intrinsic_atomic_global(struct ir3_context *ctx, nir_intrinsic_instr *intr)
    unreachable("Global atomic are unimplemented on A5xx");
 }

+static void
+emit_intrinsic_load_global_ir3(struct ir3_context *ctx,
+                               nir_intrinsic_instr *intr,
+                               struct ir3_instruction **dst)
+{
+   struct ir3_builder *b = &ctx->build;
+   unsigned dest_components = nir_intrinsic_dest_components(intr);
+   struct ir3_instruction *addr, *offset;
+
+   addr = ir3_collect(b, ir3_get_src(ctx, &intr->src[0])[0],
+                      ir3_get_src(ctx, &intr->src[0])[1]);
+
+   struct ir3_instruction *load;
+
+   bool const_offset_in_bounds =
+      nir_src_is_const(intr->src[1]) &&
+      nir_src_as_int(intr->src[1]) < (1 << 8) &&
+      nir_src_as_int(intr->src[1]) > -(1 << 8);
+
+   if (const_offset_in_bounds) {
+      load = ir3_LDG(b, addr, 0,
+                     create_immed(b, nir_src_as_int(intr->src[1]) * 4),
+                     0, create_immed(b, dest_components), 0);
+   } else {
+      offset = ir3_get_src(ctx, &intr->src[1])[0];
+      load =
+         ir3_LDG_A(b, addr, 0, offset, 0, create_immed(b, 0), 0,
+                   create_immed(b, 0), 0, create_immed(b, dest_components), 0);
+   }
+
+   load->cat6.type = type_uint_size(intr->def.bit_size);
+   load->dsts[0]->wrmask = MASK(dest_components);
+
+   load->barrier_class = IR3_BARRIER_BUFFER_R;
+   load->barrier_conflict = IR3_BARRIER_BUFFER_W;
+
+   ir3_split_dest(b, dst, load, 0, dest_components);
+}
+
+static void
+emit_intrinsic_store_global_ir3(struct ir3_context *ctx,
+                                nir_intrinsic_instr *intr)
+{
+   struct ir3_builder *b = &ctx->build;
+   struct ir3_instruction *value, *addr, *offset;
+   unsigned ncomp = nir_intrinsic_src_components(intr, 0);
+
+   addr = ir3_collect(b, ir3_get_src(ctx, &intr->src[1])[0],
+                      ir3_get_src(ctx, &intr->src[1])[1]);
+
+   value = ir3_create_collect(b, ir3_get_src(ctx, &intr->src[0]), ncomp);
+
+   struct ir3_instruction *stg;
+
+   bool const_offset_in_bounds = nir_src_is_const(intr->src[2]) &&
+                                 nir_src_as_int(intr->src[2]) < (1 << 10) &&
+                                 nir_src_as_int(intr->src[2]) > -(1 << 10);
+
+   if (const_offset_in_bounds) {
+      stg = ir3_STG(b, addr, 0,
+                    create_immed(b, nir_src_as_int(intr->src[2]) * 4), 0,
+                    value, 0,
+                    create_immed(b, ncomp), 0);
+   } else {
+      offset = ir3_get_src(ctx, &intr->src[2])[0];
+      stg =
+         ir3_STG_A(b, addr, 0, offset, 0, create_immed(b, 0), 0,
+                   create_immed(b, 0), 0, value, 0, create_immed(b, ncomp), 0);
+   }
+
+   stg->cat6.type = type_uint_size(intr->src[0].ssa->bit_size);
+   stg->cat6.iim_val = 1;
+
+   array_insert(ctx->block, ctx->block->keeps, stg);
+
+   stg->barrier_class = IR3_BARRIER_BUFFER_W;
+   stg->barrier_conflict = IR3_BARRIER_BUFFER_R | IR3_BARRIER_BUFFER_W;
+}
+
 const struct ir3_context_funcs ir3_a4xx_funcs = {
    .emit_intrinsic_load_ssbo = emit_intrinsic_load_ssbo,
    .emit_intrinsic_store_ssbo = emit_intrinsic_store_ssbo,
@@ -391,7 +470,7 @@ const struct ir3_context_funcs ir3_a4xx_funcs = {
    .emit_intrinsic_store_image = emit_intrinsic_store_image,
    .emit_intrinsic_atomic_image = emit_intrinsic_atomic_image,
    .emit_intrinsic_image_size = emit_intrinsic_image_size_tex,
-   .emit_intrinsic_load_global_ir3 = NULL,
-   .emit_intrinsic_store_global_ir3 = NULL,
+   .emit_intrinsic_load_global_ir3 = emit_intrinsic_load_global_ir3,
+   .emit_intrinsic_store_global_ir3 = emit_intrinsic_store_global_ir3,
    .emit_intrinsic_atomic_global = emit_intrinsic_atomic_global,
 };
