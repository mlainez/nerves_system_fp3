BR2_PACKAGE_WPA_SUPPLICANT_WPA_CLIENT_SO=y
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y
BR2_PACKAGE_WPA_SUPPLICANT_DBUS=y

# Host helpers
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_GENEXT2FS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_MTOOLS=y

# Nerves bookkeeping
BR2_NERVES_SYSTEM_NAME="nerves_system_fp3"
BR2_NERVES_ADDITIONAL_IMAGE_FILES="${NERVES_DEFCONFIG_DIR}/fwup.conf"
BR2_PACKAGE_NBTTY=y
BR2_PACKAGE_NERVES_CONFIG=y
BR2_PACKAGE_NERVES_CONFIG_ACCEPT_RNG_NOTICE=y

# Root filesystem: squashfs A/B inside the Android userdata partition.
# lk2nd-msm8953 reads /extlinux/extlinux.conf from the boot subpartition
# (ext2, built by scripts/create-boot-img.sh into BINARIES_DIR/boot.img)
# and loads kernel + DTB + the citronics initramfs from it. The initramfs
# kpartx-maps mmcblk0p62 into p62p1 (boot) + p62p2 (rootfs squashfs) +
# p62p3 (f2fs app data).
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_LZ4=y
# BR2_TARGET_ROOTFS_EXT2 is not set
# BR2_TARGET_ROOTFS_TAR is not set

BR2_PACKAGE_FP3_FIRMWARE=y
BR2_PACKAGE_CITRONICS_INITRAMFS=y
BR2_PACKAGE_UNUDHCPD=y
BR2_PACKAGE_QRTR=y
BR2_PACKAGE_RMTFS=y
BR2_PACKAGE_TQFTPSERV=y
BR2_PACKAGE_HEXAGONRPC=y
BR2_PACKAGE_REBOOT_MODE=y
BR2_PACKAGE_QBOOTCTL=y
BR2_PACKAGE_FP3_CAMERA_UTILS=y
BR2_PACKAGE_JPEG=y
BR2_PACKAGE_JPEG_TURBO=y

# ModemManager is no longer pulled in: the Elixir runtime drives the modem
# directly through the `:qmi` library (the same stack the FP2 Nerves system
# uses). `libqmi` stays only because rmtfs and tqftpserv link against
# `libqrtr` from the same source tree.
# BR2_PACKAGE_MODEM_MANAGER is not set

# GPU userspace — Mesa3D / Freedreno for the in-SoC Adreno 506 (a5xx).
# Brings up the full GL/GLES/EGL/GBM stack via the gallium freedreno
# driver. No Vulkan: Freedreno's turnip driver only supports a6xx+, the
# Adreno 506 is a5xx and has no production Vulkan path.
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_FREEDRENO=y
BR2_PACKAGE_MESA3D_OPENGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_GBM=y
# No OpenCL. Rusticl compiles kernels at runtime, so it drags clang and
# LLVM onto the device: 177 MB of a 520 MB rootfs, which left the 250 MiB
# rootfs partition 91% full. The a5xx compute paths in patches/mesa3d are
# kept — GLES 3.1 compute shaders go through the same ir3 code — but the
# OpenCL front end is not worth a third of the filesystem here. Set
# BR2_PACKAGE_MESA3D_{LLVM,OPENCL,RUSTICL} to bring it back.
